---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} — Indi Kolluru</title>
	</head>
	<body>
		<header class="site-header">
			<a class="site-header__name" href="/">Indi Kolluru</a>
			<nav class="site-header__nav">
				<a href="/about">About</a>
				<a href="/research">Research</a>
				<a href="/awards">Awards</a>
				<a href="/games">Games</a>
				<a href="/blog">Blog</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Archivo Black";
		src: url("/fonts/archivo-black.woff2") format("woff2");
		font-weight: 400;
		font-display: swap;
	}
	@font-face {
		font-family: "Manrope";
		src: url("/fonts/manrope-500.woff2") format("woff2");
		font-weight: 500;
		font-display: swap;
	}
	@font-face {
		font-family: "Manrope";
		src: url("/fonts/manrope-800.woff") format("woff");
		font-weight: 800;
		font-display: swap;
	}

	:root {
		color-scheme: dark;
		--void: #020304;
		--stone: #4b5b64;
		--stone-dark: #262f35;
		--stone-panel: #171d21;
		--moss: #6f9450;
		--parchment: #ece3d2;
		--parchment-dim: #a79f8f;
		--gold-hi: #ffe9a8;
		--gold-mid: #f2c25b;
		--outline: #1c140f;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		min-height: 100%;
	}

	body {
		background: var(--void);
		color: var(--parchment);
		font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
	}

	a {
		color: inherit;
	}

	h1,
	h2,
	h3 {
		font-family: "Archivo Black", ui-sans-serif, system-ui, sans-serif;
		font-weight: 400;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding: 1.1rem 1.75rem;
		background: var(--stone-panel);
		border-bottom: 2px solid var(--outline);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.site-header__name {
		font-family: "Archivo Black", ui-sans-serif, system-ui, sans-serif;
		font-size: clamp(1.5rem, 2.4vw, 2.1rem);
		letter-spacing: -0.01em;
		text-decoration: none;
		color: var(--parchment);
		text-transform: uppercase;
	}

	.site-header__nav {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.site-header__nav a {
		font-family: "Manrope", sans-serif;
		font-weight: 500;
		font-size: 0.95rem;
		text-decoration: none;
		color: var(--parchment-dim);
		letter-spacing: 0.02em;
	}

	.site-header__nav a:hover {
		color: var(--gold-hi);
	}

	main {
		min-height: calc(100vh - 73px);
	}
</style>
