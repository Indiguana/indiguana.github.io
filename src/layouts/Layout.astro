---
import { gameQuotes } from "../data/quotes";

interface Props {
	title: string;
}

const { title } = Astro.props;

// Slower for longer lists, so the reading pace stays roughly constant.
const marqueeDuration = `${gameQuotes.length * 4}s`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} — Indi Kolluru</title>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__brand">
				<a class="site-header__name" href="/">Indi Kolluru</a>
				<nav class="site-header__nav">
					<a href="/about">About</a>
					<a href="/research">Research</a>
					<a href="/awards">Awards</a>
					<a href="/games">Games</a>
					<a href="/blog">Blog</a>
				</nav>
			</div>

			<div class="quote-band" aria-hidden="true">
				<div class="quote-band__track" style={`--marquee-duration: ${marqueeDuration}`}>
					{
						[0, 1].map(() => (
							<div class="quote-band__list">
								{gameQuotes.map((q) => (
									<>
										<span class="quote" data-quote={`“${q.text}”`}>“{q.text}”</span>
										{/* Own element, not a ::after on .quote — the quote's width
										    is pinned and clipped, which would eat the dot. */}
										<span class="quote-dot">·</span>
									</>
								))}
							</div>
						))
					}
				</div>
			</div>
		</header>
		<main>
			<slot />
		</main>

		<script>
			/* Quotes resolve out of noise as they cross the middle of the banner,
			   and scramble again on their way off either edge. */
			const band = document.querySelector<HTMLElement>(".quote-band");
			const quotes = Array.from(document.querySelectorAll<HTMLElement>(".quote"));
			const stillPlease = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			if (band && quotes.length > 0 && !stillPlease) {
				// Array.from keeps the astral glyphs (hieroglyphs, emoji) as whole
				// characters instead of splitting them into surrogate halves.
				const GLYPHS = Array.from(
					"ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩαβγδεζηθικλμνξοπρστυφχψω" +
					"अआइईउऊऋएऐओऔकखगघचछजझटठडढणतथदधनपफबभमयरलवशषसह" +
					"𓀀𓁐𓂀𓃒𓄿𓅓𓆑𓇋𓈖𓉐𓊃𓋴𓌂𓍿𓎛𓏏" +
					"ᚠᚢᚦᚨᚱᚲᚷᚹᚻᚾᛁᛃᛇᛈᛉᛊᛏᛒᛖᛗᛚᛜᛞᛟ" +
					"⚔🗡🛡🔥👾🎮💀🌙⭐🐉"
				);
				// Fraction of the band's width, at each end, spent resolving.
				const RAMP = 0.3;

				function noise(seed: number) {
					const n = Math.sin(seed * 12.9898) * 43758.5453;
					return n - Math.floor(n);
				}

				type Line = { cells: HTMLElement[]; chars: string[]; shown: string[]; revealAt: number[] };
				let lines: Line[] = [];

				/* A Greek letter, a hieroglyph and an "e" are all different widths, so
				   swapping them inside one text node would resize the quote and drag the
				   marquee's loop point with it. Instead each character gets its own cell,
				   fixed to the width the real character occupies: whatever glyph lands in
				   a cell, the line stays exactly as wide as the sentence it spells. */
				function buildCells() {
					lines = quotes.map((q) => {
						const text = q.dataset.quote || "";
						const chars = Array.from(text);

						q.style.width = "";
						q.textContent = text;
						const width = q.getBoundingClientRect().width;

						// Per-character advances, measured from the real laid-out text so
						// the split version sits where the unsplit one did.
						const range = document.createRange();
						const node = q.firstChild!;
						const cells: HTMLElement[] = [];
						let offset = 0;
						for (const ch of chars) {
							range.setStart(node, offset);
							range.setEnd(node, offset + ch.length);
							const cell = document.createElement("span");
							cell.className = "glyph";
							cell.style.width = `${range.getBoundingClientRect().width}px`;
							cell.textContent = ch;
							cells.push(cell);
							offset += ch.length;
						}

						q.replaceChildren(...cells);
						q.style.width = `${width}px`;

						return {
							cells,
							chars,
							shown: chars.slice(),
							// Each character resolves at its own point in the sweep, so the
							// quote speckles into place rather than wiping left to right.
							revealAt: chars.map((_, i) => 0.15 + noise(i * 2.7 + 1.3) * 0.85),
						};
					});
				}

				let frame = 0;
				function tick() {
					frame += 1;
					// Position updates every frame so the reveal stays smooth, but the
					// glyphs themselves only churn every 3rd frame (~20/sec).
					const churn = Math.floor(frame / 3);
					const bandBox = band!.getBoundingClientRect();

					quotes.forEach((q, qi) => {
						const line = lines[qi];
						if (!line) return;

						const box = q.getBoundingClientRect();
						if (box.right < bandBox.left || box.left > bandBox.right) return;

						const at = (box.left + box.width / 2 - bandBox.left) / bandBox.width;
						let progress = 1;
						if (at > 1 - RAMP) progress = (1 - at) / RAMP;
						else if (at < RAMP) progress = at / RAMP;
						progress = Math.min(1, Math.max(0, progress));

						for (let i = 0; i < line.chars.length; i++) {
							const ch = line.chars[i];
							// Leave spaces and punctuation alone; scrambling only the
							// letters keeps the shape of the line recognisable.
							const target =
								!/[a-z]/i.test(ch) || progress >= line.revealAt[i]
									? ch
									: GLYPHS[Math.floor(noise(i * 31.7 + churn * 1.7) * GLYPHS.length)];
							if (line.shown[i] !== target) {
								line.cells[i].textContent = target;
								line.shown[i] = target;
							}
						}
						q.style.opacity = String(0.4 + 0.6 * progress);
					});

					requestAnimationFrame(tick);
				}

				let resizeTimer = 0;
				window.addEventListener("resize", () => {
					window.clearTimeout(resizeTimer);
					resizeTimer = window.setTimeout(buildCells, 150);
				});

				// Measure once the webfont is in place, or the cells are Manrope-sized.
				document.fonts.ready.then(() => {
					buildCells();
					requestAnimationFrame(tick);
				});
			}
		</script>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Archivo Black";
		src: url("/fonts/archivo-black.woff2") format("woff2");
		font-weight: 400;
		font-display: swap;
	}
	@font-face {
		font-family: "Manrope";
		src: url("/fonts/manrope-500.woff2") format("woff2");
		font-weight: 500;
		font-display: swap;
	}
	@font-face {
		font-family: "Manrope";
		src: url("/fonts/manrope-800.woff") format("woff");
		font-weight: 800;
		font-display: swap;
	}

	:root {
		color-scheme: dark;
		--void: #020304;
		--stone: #4b5b64;
		--stone-dark: #262f35;
		--stone-panel: #171d21;
		--moss: #6f9450;
		--parchment: #ece3d2;
		--parchment-dim: #a79f8f;
		--gold-hi: #ffe9a8;
		--gold-mid: #f2c25b;
		/* Warmer and brighter than --gold-mid so it stays legible against the
		   header panel while the quotes are half-scrambled and dimmed. */
		--quote-gold: #ffc247;
		--font-historical: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua",
			"Hoefler Text", Georgia, "Times New Roman", serif;
		--outline: #1c140f;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		min-height: 100%;
	}

	body {
		background: var(--void);
		color: var(--parchment);
		font-family: "Manrope", ui-sans-serif, system-ui, sans-serif;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	a {
		color: inherit;
	}

	h1,
	h2,
	h3 {
		font-family: "Archivo Black", ui-sans-serif, system-ui, sans-serif;
		font-weight: 400;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.site-header {
		display: flex;
		align-items: center;
		gap: 0.75rem 2.5rem;
		flex-wrap: wrap;
		padding: 1.1rem 1.75rem;
		background: var(--stone-panel);
		border-bottom: 2px solid var(--outline);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.site-header__brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.35rem;
		flex: 0 0 auto;
	}

	.site-header__name {
		font-family: "Archivo Black", ui-sans-serif, system-ui, sans-serif;
		font-size: clamp(1.5rem, 2.4vw, 2.1rem);
		letter-spacing: -0.01em;
		text-decoration: none;
		color: var(--parchment);
		text-transform: uppercase;
	}

	.site-header__nav {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	/* Same chip treatment as the brazier labels on the home page. */
	.site-header__nav a {
		font-family: "Manrope", sans-serif;
		font-weight: 800;
		font-size: 1rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--outline);
		background: var(--parchment);
		border: 2px solid var(--outline);
		padding: 0.4rem 1rem;
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.site-header__nav a:hover,
	.site-header__nav a:focus-visible {
		background: var(--gold-hi);
		transform: translateY(-1px);
	}

	/* ---- scrolling game-quote banner ---- */
	.quote-band {
		flex: 1 1 20rem;
		min-width: 0;
		overflow: hidden;
		/* Sits on the header panel, not the cave, so the text stays readable. */
		background: var(--stone-panel);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
		mask-image: linear-gradient(90deg, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
	}

	.quote-band__track {
		display: flex;
		width: max-content;
		animation: quote-marquee var(--marquee-duration, 60s) linear infinite;
	}

	.quote-band__list {
		display: flex;
		flex: 0 0 auto;
	}

	/* Trailing margin on every item (rather than a flex gap) keeps the two
	   copies evenly spaced, so the -50% loop point is seamless. */
	.quote {
		flex: 0 0 auto;
		margin-right: 1.1rem;
		white-space: pre;
		overflow: hidden;
		/* Old-book serifs rather than the site's Manrope — all system faces, so
		   there's nothing extra to download and no flash of fallback text. */
		font-family: var(--font-historical);
		font-size: clamp(1.1rem, 1.9vw, 1.6rem);
		line-height: 1.4;
		font-style: italic;
		color: var(--quote-gold);
		text-shadow: 0 0 14px rgba(255, 190, 74, 0.28);
	}

	/* One fixed-width box per character — a hieroglyph dropped into an "e" slot
	   may spill over its neighbours, but the line never changes length. */
	.quote .glyph {
		display: inline-block;
		text-align: center;
	}

	.quote-dot {
		flex: 0 0 auto;
		margin-right: 1.1rem;
		font-family: var(--font-historical);
		font-size: clamp(1.1rem, 1.9vw, 1.6rem);
		line-height: 1.4;
		color: var(--quote-gold);
		opacity: 0.5;
	}

	@keyframes quote-marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.quote-band {
			overflow-x: auto;
		}

		.quote-band__track {
			animation: none;
		}
	}

	main {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
</style>
