---
import Layout from "../../layouts/Layout.astro";
import { researchProjects } from "../../data/researchProjects";
import { getEntry, render } from "astro:content";

export async function getStaticPaths() {
	const withDetailPage = researchProjects.filter((p) => p.poster || p.writeup);
	return Promise.all(
		withDetailPage.map(async (p) => {
			const writeup = p.writeup ? await getEntry("writeups", p.slug) : undefined;
			const Content = writeup ? (await render(writeup)).Content : undefined;
			return {
				params: { slug: p.slug },
				props: { project: p, Content },
			};
		})
	);
}

const { project, Content } = Astro.props;
---

<Layout title={project.title}>
	<section class="poster-page">
		<a class="back-link" href="/research">← Research</a>

		<div class="head">
			<h1>{project.title}</h1>
			<div class="meta">
				<span class="dates">{project.dates}</span>
				{project.githubLink && (
					<a class="repo-link" href={project.githubLink} target="_blank" rel="noopener noreferrer">
						View on GitHub →
					</a>
				)}
			</div>
			{!Content && <p class="description">{project.description}</p>}
		</div>

		{project.poster && <img class="poster" src={project.poster} alt={`${project.title} — poster board`} />}

		{Content && (
			<div class="writeup">
				<Content />
			</div>
		)}
	</section>
</Layout>

<style>
	.poster-page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 3.5rem 1.5rem 5rem;
	}

	.back-link {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--gold-mid);
		text-decoration: none;
		margin-bottom: 2rem;
	}

	.back-link:hover {
		color: var(--gold-hi);
	}

	.head {
		margin-bottom: 2rem;
	}

	h1 {
		font-size: clamp(1.6rem, 3.5vw, 2.4rem);
		color: var(--gold-hi);
		margin: 0 0 0.75rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.25rem;
		margin-bottom: 1rem;
	}

	.dates {
		font-size: 0.85rem;
		color: var(--parchment-dim);
	}

	.repo-link {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--gold-mid);
		text-decoration: none;
	}

	.repo-link:hover {
		color: var(--gold-hi);
	}

	.description {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--parchment);
		max-width: 70ch;
		margin: 0;
	}

	.poster {
		display: block;
		width: 100%;
		height: auto;
		border: 2px solid var(--outline);
	}

	.writeup {
		max-width: 70ch;
		color: var(--parchment);
		line-height: 1.65;
		font-size: 0.95rem;
	}

	.writeup :global(h2) {
		font-size: 1.2rem;
		color: var(--gold-mid);
		border-bottom: 2px solid var(--stone-dark);
		padding-bottom: 0.4rem;
		margin: 2.25rem 0 1rem;
	}

	.writeup :global(h2:first-child) {
		margin-top: 0;
	}

	.writeup :global(p) {
		margin: 0 0 1rem;
	}

	.writeup :global(ol),
	.writeup :global(ul) {
		margin: 0 0 1rem;
		padding-left: 1.25rem;
	}

	.writeup :global(li) {
		margin-bottom: 0.4rem;
	}

	.writeup :global(a) {
		color: var(--gold-mid);
	}

	.writeup :global(a:hover) {
		color: var(--gold-hi);
	}

	.writeup :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 2px solid var(--outline);
		margin: 1rem 0 0.5rem;
	}

	.writeup :global(strong) {
		color: var(--gold-hi);
	}

	.writeup :global(code) {
		background: var(--stone-panel);
		border: 1px solid var(--stone-dark);
		padding: 0.1rem 0.35rem;
		font-size: 0.85em;
	}
</style>
