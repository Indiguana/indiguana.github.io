---
import Layout from "../../layouts/Layout.astro";
import { researchProjects } from "../../data/researchProjects";

export function getStaticPaths() {
	return researchProjects
		.filter((p) => p.poster)
		.map((p) => ({
			params: { slug: p.slug },
			props: { project: p },
		}));
}

const { project } = Astro.props;
---

<Layout title={project.title}>
	<section class="poster-page">
		<a class="back-link" href="/research">← Research</a>

		<div class="head">
			<h1>{project.title}</h1>
			<div class="meta">
				<span class="dates">{project.dates}</span>
				{project.githubLink && (
					<a class="repo-link" href={project.githubLink} target="_blank" rel="noopener noreferrer">
						View on GitHub →
					</a>
				)}
			</div>
			<p class="description">{project.description}</p>
		</div>

		<img class="poster" src={project.poster} alt={`${project.title} — poster board`} />
	</section>
</Layout>

<style>
	.poster-page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 3.5rem 1.5rem 5rem;
	}

	.back-link {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--gold-mid);
		text-decoration: none;
		margin-bottom: 2rem;
	}

	.back-link:hover {
		color: var(--gold-hi);
	}

	.head {
		margin-bottom: 2rem;
	}

	h1 {
		font-size: clamp(1.6rem, 3.5vw, 2.4rem);
		color: var(--gold-hi);
		margin: 0 0 0.75rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.25rem;
		margin-bottom: 1rem;
	}

	.dates {
		font-size: 0.85rem;
		color: var(--parchment-dim);
	}

	.repo-link {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--gold-mid);
		text-decoration: none;
	}

	.repo-link:hover {
		color: var(--gold-hi);
	}

	.description {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--parchment);
		max-width: 70ch;
		margin: 0;
	}

	.poster {
		display: block;
		width: 100%;
		height: auto;
		border: 2px solid var(--outline);
	}
</style>
