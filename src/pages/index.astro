---
import Layout from "../layouts/Layout.astro";
import Brazier from "../components/Brazier.astro";
---

<Layout title="Home">
	<section class="cave">
		<div class="shrine">
			<div class="pillar">
				<div class="pillar__capital"></div>
				<div class="pillar__shaft">
					<span class="pillar__flute"></span>
					<span class="pillar__flute"></span>
					<span class="pillar__flute"></span>
					<span class="pillar__flute"></span>
				</div>
				<div class="pillar__base"></div>

				<div class="portrait" aria-hidden="true">photo</div>
			</div>

			<p class="shrine__tagline">Research &middot; Awards &middot; Games &middot; Blog</p>

			<div class="braziers">
				<Brazier href="/research" label="Research" delay={0} />
				<Brazier href="/awards" label="Awards" delay={0.4} />
				<Brazier href="/games" label="Games" delay={0.8} />
				<Brazier href="/blog" label="Blog" delay={1.2} />
			</div>
		</div>
	</section>
</Layout>

<style>
	.cave {
		min-height: calc(100vh - 60px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 3rem 1rem;
		background:
			radial-gradient(ellipse 60% 40% at 50% 20%, rgba(255, 157, 66, 0.08), transparent 70%),
			radial-gradient(ellipse 120% 80% at 50% 100%, var(--stone) 0%, var(--cave-black) 60%),
			var(--cave-black);
	}

	.shrine {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		max-width: 720px;
		width: 100%;
	}

	.pillar {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.portrait {
		position: absolute;
		top: -70px;
		width: 110px;
		height: 110px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, #d8ceb8, #a89f8c);
		border: 4px solid var(--ember);
		box-shadow: 0 0 20px 6px rgba(255, 157, 66, 0.35);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--cave-black);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.pillar__capital {
		width: 140px;
		height: 22px;
		background: linear-gradient(var(--parchment), #c9bfa8);
		clip-path: polygon(10% 100%, 0 0, 100% 0, 90% 100%);
	}

	.pillar__shaft {
		position: relative;
		width: 90px;
		height: 220px;
		background: linear-gradient(90deg, #c9bfa8, var(--parchment) 50%, #c9bfa8);
		display: flex;
		justify-content: space-evenly;
		padding: 0 8px;
	}

	.pillar__flute {
		width: 2px;
		height: 100%;
		background: rgba(0, 0, 0, 0.12);
	}

	.pillar__base {
		width: 160px;
		height: 24px;
		background: linear-gradient(#c9bfa8, var(--parchment));
		clip-path: polygon(0 0, 100% 0, 90% 100%, 10% 100%);
	}

	.shrine__tagline {
		margin: 0;
		opacity: 0.75;
		font-size: 0.95rem;
		letter-spacing: 0.04em;
		text-align: center;
	}

	.braziers {
		display: flex;
		gap: 2.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	@media (max-width: 480px) {
		.braziers {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.75rem;
			justify-items: center;
		}
	}
</style>
