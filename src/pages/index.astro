---
import Layout from "../layouts/Layout.astro";
import Brazier from "../components/Brazier.astro";
---

<Layout title="Home">
	<canvas id="cave-canvas"></canvas>

	<section class="scene">
		<div class="shrine">
			<div class="pillar-wrap">
				<canvas id="pillar-canvas"></canvas>
				<a class="portrait" href="/about" aria-label="About Indi">
					<img src="/images/portrait.jpg" alt="" />
				</a>
			</div>

			<div class="braziers">
				<Brazier href="/research" label="Research" logoSrc="/images/logos/research.png" flameSeed={0} />
				<Brazier href="/awards" label="Awards" logoSrc="/images/logos/awards.png" flameSeed={1} />
				<Brazier href="/games" label="Games" logoSrc="/images/logos/games.png" flameSeed={0} />
				<Brazier href="/blog" label="Blog" logoSrc="/images/logos/blog.png" flameSeed={1} />
			</div>
		</div>
	</section>
</Layout>

<style>
	#cave-canvas {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		image-rendering: pixelated;
		image-rendering: crisp-edges;
	}

	.scene {
		position: relative;
		z-index: 2;
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 1rem 2.5rem;
	}

	.shrine {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.25rem;
		max-width: 960px;
		width: 100%;
	}

	.pillar-wrap {
		position: relative;
		display: flex;
		justify-content: center;
		margin-top: 6rem;
	}

	.pillar-wrap canvas {
		image-rendering: pixelated;
		image-rendering: crisp-edges;
		width: 211px;
		height: 298px;
	}

	.portrait {
		position: absolute;
		top: -118px;
		left: 50%;
		transform: translateX(-50%);
		width: 172px;
		height: 172px;
		border-radius: 50%;
		overflow: hidden;
		background: #a89f8c;
		border: 6px solid var(--outline);
		outline: 4px solid var(--gold-mid);
		display: block;
		text-decoration: none;
		cursor: pointer;
		transition: outline-color 0.15s ease, transform 0.15s ease;
	}

	.portrait img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.portrait:hover,
	.portrait:focus-visible {
		outline-color: var(--gold-hi);
		transform: translateX(-50%) scale(1.03);
	}

	.braziers {
		display: flex;
		gap: 5.5rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 3rem;
	}

	@media (max-width: 480px) {
		.braziers {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem 1.25rem;
			justify-items: center;
		}
	}
</style>

<script>
	function makeGrid(cols: number, rows: number, fill?: string) {
		const g: string[][] = [];
		for (let y = 0; y < rows; y++) {
			g.push(new Array(cols).fill(fill || "."));
		}
		return g;
	}

	function stampBand(grid: string[][], x0: number, y0: number, x1: number, y1: number) {
		for (let y = y0; y <= y1; y++) {
			for (let x = x0; x <= x1; x++) {
				if (y === y0 || y === y1 || x === x0 || x === x1) {
					grid[y][x] = "K";
				} else {
					const rel = (x - x0) / (x1 - x0);
					grid[y][x] = rel < 0.32 ? "H" : rel < 0.68 ? "M" : "D";
				}
			}
		}
	}

	function stampFlutes(grid: string[][], xs: number[], y0: number, y1: number) {
		xs.forEach((x) => {
			for (let y = y0 + 1; y < y1; y++) {
				grid[y][x] = "G";
			}
		});
	}

	function drawGrid(canvas: HTMLCanvasElement, grid: string[][], palette: Record<string, string>) {
		const rows = grid.length,
			cols = grid[0].length;
		canvas.width = cols;
		canvas.height = rows;
		const ctx = canvas.getContext("2d")!;
		ctx.imageSmoothingEnabled = false;
		ctx.clearRect(0, 0, cols, rows);
		for (let y = 0; y < rows; y++) {
			for (let x = 0; x < cols; x++) {
				const ch = grid[y][x];
				if (ch === ".") continue;
				ctx.fillStyle = palette[ch];
				ctx.fillRect(x, y, 1, 1);
			}
		}
	}

	const PILLAR_PALETTE: Record<string, string> = { H: "#ffe9a8", M: "#f2c25b", D: "#d99e3c", G: "#a8711f", K: "#2a1c0d" };
	const BRAZIER_PALETTE: Record<string, string> = { H: "#eef4f8", M: "#c9d9e3", D: "#7f97a8", G: "#3f5563", K: "#1a2530" };
	const FLAME_PALETTE: Record<string, string> = { Y: "#ffd35c", O: "#f4812f", R: "#c62828" };

	function buildPillar() {
		const cols = 34,
			rows = 48;
		const g = makeGrid(cols, rows);
		stampBand(g, 3, 0, 30, 3);
		stampBand(g, 6, 4, 27, 5);
		stampBand(g, 9, 6, 24, 9);
		stampBand(g, 7, 10, 26, 11);
		stampBand(g, 11, 12, 22, 35);
		stampFlutes(g, [13, 15, 17, 19, 21], 12, 35);
		stampBand(g, 7, 36, 26, 37);
		stampBand(g, 9, 38, 24, 41);
		stampBand(g, 6, 42, 27, 43);
		stampBand(g, 3, 44, 30, 47);
		return g;
	}

	function buildBrazierBody() {
		const cols = 20,
			rows = 39;
		const g = makeGrid(cols, rows);
		stampBand(g, 1, 2, 18, 4);
		stampBand(g, 4, 5, 15, 7);
		stampBand(g, 7, 8, 12, 9);
		stampBand(g, 3, 10, 16, 14);
		for (let y = 11; y <= 13; y++) {
			for (let x = 4; x <= 6; x++) g[y][x] = "H";
			for (let x2 = 13; x2 <= 15; x2++) g[y][x2] = "H";
		}
		stampBand(g, 7, 15, 12, 30);
		stampFlutes(g, [9], 15, 30);
		stampBand(g, 5, 31, 14, 32);
		stampBand(g, 3, 33, 16, 35);
		stampBand(g, 1, 36, 18, 38);
		return g;
	}

	function buildFlame(seed: number) {
		const cols = 13,
			rows = 17;
		const g = makeGrid(cols, rows);
		const center = (cols - 1) / 2;
		for (let y = 0; y < rows; y++) {
			const t = y / (rows - 1);
			const bulge = Math.sin(Math.PI * t);
			const maxHalf = 0.7 + bulge * 4.7 + Math.sin(t * 9 + seed) * 0.4;
			const lean = Math.sin(t * 5 + seed) * 0.9;
			for (let x = 0; x < cols; x++) {
				const dx = x - center - lean;
				const dist = Math.abs(dx);
				if (dist > maxHalf) continue;
				const rel = dist / maxHalf;
				let ch: string | null;
				if (t < 0.12) ch = rel < 0.55 ? "O" : null;
				else if (rel < 0.4) ch = "Y";
				else if (rel < 0.75) ch = "O";
				else ch = "R";
				if (ch) g[y][x] = ch;
			}
		}
		return g;
	}

	const pillarCanvas = document.getElementById("pillar-canvas") as HTMLCanvasElement;
	drawGrid(pillarCanvas, buildPillar(), PILLAR_PALETTE);

	document.querySelectorAll<HTMLCanvasElement>("[data-brazier]").forEach((c) => {
		drawGrid(c, buildBrazierBody(), BRAZIER_PALETTE);
	});

	const flameCanvases = document.querySelectorAll<HTMLCanvasElement>("[data-flame]");
	const flameSeeds: number[] = [];
	flameCanvases.forEach((c, i) => {
		flameSeeds.push(parseFloat(c.getAttribute("data-flame") || "0") * 3 + i);
	});

	let frame = 0;
	function tickFlames() {
		frame += 1;
		flameCanvases.forEach((c, i) => {
			drawGrid(c, buildFlame(flameSeeds[i] + frame * 1.7), FLAME_PALETTE);
		});
	}
	tickFlames();
	setInterval(tickFlames, 260);

	/* ---- cave background canvas ---- */
	const caveCanvas = document.getElementById("cave-canvas") as HTMLCanvasElement;
	const COLS = 160,
		ROWS = 90;
	caveCanvas.width = COLS;
	caveCanvas.height = ROWS;
	const ctx = caveCanvas.getContext("2d")!;
	ctx.imageSmoothingEnabled = false;

	function jag(y: number, phase: number) {
		return Math.sin(y * 0.6 + phase) * 3 + Math.sin(y * 1.7 + phase * 2) * 1.6 + Math.sin(y * 3.1 + phase) * 0.8;
	}

	for (let y = 0; y < ROWS; y++) {
		const t = y / (ROWS - 1);
		let widthFrac = 0.1 + 0.62 * Math.pow(t, 0.65);
		if (t > 0.55) widthFrac = Math.min(widthFrac, 0.6);
		const half = (widthFrac * COLS) / 2;
		const cx = COLS / 2;
		const leftEdge = cx - half + jag(y, 1.3);
		const rightEdge = cx + half - jag(y, 4.1);

		for (let x = 0; x < COLS; x++) {
			const interior = x > leftEdge && x < rightEdge;
			const isFloor = interior && t > 0.5;
			let color: string;

			if (isFloor) {
				const tileX = Math.floor(x / 5);
				const tileY = Math.floor((y - ROWS * 0.5) / 3);
				const base = (tileX + tileY) % 2 === 0 ? "#22282c" : "#1c2124";
				const edgeGrout = x % 5 === 0 || (y - Math.floor(ROWS * 0.5)) % 3 === 0;
				color = edgeGrout ? "#121517" : base;
				const mossSeed = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453;
				const mossVal = mossSeed - Math.floor(mossSeed);
				if (mossVal > 0.965) color = "#40592c";
			} else if (interior) {
				const skyTones = ["#03060f", "#050a1e", "#071230", "#0a173d"];
				const bandIdx = Math.min(skyTones.length - 1, Math.floor((t / 0.5) * skyTones.length));
				color = skyTones[bandIdx];
				if ((x * 7 + y * 13) % 17 === 0 && bandIdx < skyTones.length - 1) {
					color = skyTones[bandIdx + 1];
				}
				if (t < 0.45) {
					const starSeed = Math.sin(x * 91.3 + y * 47.1) * 31721.4;
					const starVal = starSeed - Math.floor(starSeed);
					if (starVal > 0.985) color = "#eef2ff";
					else if (starVal > 0.975) color = "#8f9ac2";
				}
			} else {
				const distToEdge = Math.min(Math.abs(x - leftEdge), Math.abs(x - rightEdge));
				const dither = (x + y) % 2 === 0;
				color = dither ? "#252d32" : "#1a1f23";
				if (y < 2) color = "#0e1214";
				if (distToEdge < 2.4) {
					const mSeed = Math.sin(x * 33.1 + y * 12.7) * 12543.7;
					const mVal = mSeed - Math.floor(mSeed);
					if (mVal > 0.62) color = mVal > 0.82 ? "#5c7d40" : "#3f572c";
				}
			}
			ctx.fillStyle = color;
			ctx.fillRect(x, y, 1, 1);
		}
	}

	/* crescent moon, carved from two overlapping discs */
	const moonCx = COLS / 2 + 11,
		moonCy = ROWS * 0.16,
		moonR = 5;
	const biteCx = moonCx + 2.6,
		biteCy = moonCy - 1.6,
		biteR = 4.3;
	for (let my = Math.floor(moonCy - moonR - 1); my <= moonCy + moonR + 1; my++) {
		for (let mx = Math.floor(moonCx - moonR - 1); mx <= moonCx + moonR + 1; mx++) {
			const dMain = Math.hypot(mx - moonCx, my - moonCy);
			const dBite = Math.hypot(mx - biteCx, my - biteCy);
			if (dMain <= moonR && dBite > biteR) {
				ctx.fillStyle = dMain > moonR - 1.1 ? "#d8cf9e" : "#f5eecb";
				ctx.fillRect(mx, my, 1, 1);
			}
		}
	}
</script>
