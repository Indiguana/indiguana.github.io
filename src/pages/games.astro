---
import Layout from "../layouts/Layout.astro";
import { currentlyPlaying } from "../data/currentlyPlaying";
import { gamesList, type GameEntry } from "../data/gamesList";

const apiKey = import.meta.env.STEAMGRIDDB_API_KEY;

interface SgdbSearchResult {
	id: number;
	name: string;
}

interface SgdbGrid {
	url: string;
}

async function fetchCoverUrl(title: string): Promise<string | null> {
	if (!title || !apiKey) return null;
	try {
		const searchRes = await fetch(`https://www.steamgriddb.com/api/v2/search/autocomplete/${encodeURIComponent(title)}`, {
			headers: { Authorization: `Bearer ${apiKey}` },
		});
		if (!searchRes.ok) {
			console.warn(`SteamGridDB search failed for "${title}": ${searchRes.status}`);
			return null;
		}
		const searchJson = await searchRes.json();
		const results: SgdbSearchResult[] = searchJson.data ?? [];
		if (results.length === 0) {
			console.warn(`SteamGridDB found no games for "${title}"`);
			return null;
		}
		const gameId = results[0].id;

		const gridsRes = await fetch(`https://www.steamgriddb.com/api/v2/grids/game/${gameId}?dimensions=600x900&limit=1`, {
			headers: { Authorization: `Bearer ${apiKey}` },
		});
		if (!gridsRes.ok) {
			console.warn(`SteamGridDB grids lookup failed for "${title}": ${gridsRes.status}`);
			return null;
		}
		const gridsJson = await gridsRes.json();
		const grids: SgdbGrid[] = gridsJson.data ?? [];
		return grids[0]?.url ?? null;
	} catch (err) {
		console.warn(`SteamGridDB lookup errored for "${title}":`, err);
		return null;
	}
}

if (!apiKey) {
	console.warn("STEAMGRIDDB_API_KEY is not set — skipping cover art lookups on the Games page.");
}

const currentCover = await fetchCoverUrl(currentlyPlaying.title);
const hasBanner = Boolean(currentlyPlaying.title || currentlyPlaying.notes);

const listWithCovers: { entry: GameEntry; cover: string | null }[] = await Promise.all(
	gamesList.map(async (entry) => ({ entry, cover: await fetchCoverUrl(entry.title) }))
);
---

<Layout title="Games">
	<section class="games">
		<h1>Games</h1>

		{
			hasBanner && (
				<div class="banner" style={currentCover ? `--bg: url(${currentCover})` : undefined}>
					<div class="banner-inner">
						<span class="eyebrow">Currently playing</span>
						<h2>{currentlyPlaying.title || "Untitled"}</h2>
						<div class="tags">{currentlyPlaying.platform && <span class="tag">{currentlyPlaying.platform}</span>}</div>
						{currentlyPlaying.notes && <p class="notes">{currentlyPlaying.notes}</p>}
					</div>
				</div>
			)
		}

		{!hasBanner && <p class="placeholder">Nothing set as currently playing — edit src/data/currentlyPlaying.ts.</p>}

		<h2 class="section-title">Reviews</h2>

		{listWithCovers.length === 0 && <p class="placeholder">No games listed yet — add entries to src/data/gamesList.ts.</p>}

		{
			listWithCovers.length > 0 && (
				<ul class="grid">
					{listWithCovers.map(({ entry, cover }) => (
						<li class="card">
							<div class="cover" style={cover ? `--cover: url(${cover})` : undefined}>
								{!cover && <span class="cover-fallback">{entry.title.slice(0, 1)}</span>}
							</div>
							<div class="card-body">
								<h3>{entry.title}</h3>
								<div class="tags">
									<span class="tag">{entry.platform}</span>
									{entry.rating && <span class="tag tag-rating">{entry.rating}</span>}
								</div>
								<p class="note">{entry.note}</p>
							</div>
						</li>
					))}
				</ul>
			)
		}
	</section>
</Layout>

<style>
	.games {
		max-width: 960px;
		margin: 0 auto;
		padding: 3.5rem 1.5rem 5rem;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		color: var(--gold-hi);
		margin: 0 0 2.5rem;
	}

	.section-title {
		font-size: 1.3rem;
		color: var(--gold-mid);
		border-bottom: 2px solid var(--stone-dark);
		padding-bottom: 0.5rem;
		margin: 2.5rem 0 1.5rem;
	}

	.banner {
		position: relative;
		border: 2px solid var(--outline);
		background-color: var(--stone-panel);
		background-image: var(--bg, none);
		background-size: cover;
		background-position: center;
		min-height: 260px;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
	}

	.banner::before {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(2, 3, 4, 0.15) 0%, rgba(2, 3, 4, 0.92) 100%);
	}

	.banner-inner {
		position: relative;
		z-index: 1;
		padding: 1.75rem 2rem;
		width: 100%;
	}

	.eyebrow {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--outline);
		background: var(--gold-mid);
		padding: 0.25rem 0.6rem;
		margin-bottom: 0.6rem;
	}

	.banner h2 {
		font-size: clamp(1.5rem, 3.5vw, 2.1rem);
		margin: 0 0 0.6rem;
		color: var(--parchment);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.9rem;
	}

	.tag {
		font-size: 0.78rem;
		font-weight: 500;
		color: var(--parchment-dim);
		border: 1px solid var(--stone);
		padding: 0.2rem 0.55rem;
	}

	.tag-rating {
		color: var(--outline);
		background: var(--gold-mid);
		border-color: var(--gold-mid);
		font-weight: 800;
	}

	.notes {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--parchment);
		max-width: 60ch;
		margin: 0;
	}

	.placeholder {
		color: var(--parchment-dim);
		font-size: 0.95rem;
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.25rem;
	}

	.card {
		border: 2px solid var(--outline);
		background: var(--stone-panel);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.cover {
		height: 140px;
		background-color: var(--stone-dark);
		background-image: var(--cover, none);
		background-size: cover;
		background-position: center;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.cover-fallback {
		font-family: "Archivo Black", ui-sans-serif, system-ui, sans-serif;
		font-size: 2rem;
		color: var(--parchment-dim);
	}

	.card-body {
		padding: 1rem 1.1rem 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.card-body h3 {
		font-size: 1rem;
		margin: 0;
		color: var(--parchment);
	}

	.card-body .tags {
		margin-bottom: 0;
	}

	.note {
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--parchment-dim);
		margin: 0;
	}
</style>
