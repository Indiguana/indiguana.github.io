---
import Layout from "../layouts/Layout.astro";
import { researchProjects } from "../data/researchProjects";
---

<Layout title="Research">
	<section class="research">
		<h1>Research</h1>
		<ol class="projects">
			{
				researchProjects.map((p) => (
					<li class="project">
						<div class="project-head">
							{p.poster ? (
								<a class="title-link" href={`/research/${p.slug}`}>
									<h2>{p.title}</h2>
								</a>
							) : (
								<h2>{p.title}</h2>
							)}
							<span class="dates">{p.dates}</span>
						</div>
						<p>{p.description}</p>
						<div class="links">
							{p.poster && (
								<a class="poster-link" href={`/research/${p.slug}`}>
									View writeup →
								</a>
							)}
							{p.githubLink && (
								<a class="repo-link" href={p.githubLink} target="_blank" rel="noopener noreferrer">
									View on GitHub →
								</a>
							)}
						</div>
					</li>
				))
			}
		</ol>
	</section>
</Layout>

<style>
	.research {
		max-width: 760px;
		margin: 0 auto;
		padding: 3.5rem 1.5rem 5rem;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		color: var(--gold-hi);
		margin: 0 0 2.5rem;
	}

	.projects {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.project {
		background: var(--stone-panel);
		border: 2px solid var(--outline);
		padding: 1.5rem 1.75rem;
	}

	.project-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.6rem;
	}

	.project-head h2 {
		font-size: 1.1rem;
		margin: 0;
		color: var(--parchment);
	}

	.title-link {
		text-decoration: none;
	}

	.title-link:hover h2,
	.title-link:focus-visible h2 {
		color: var(--gold-hi);
	}

	.dates {
		font-size: 0.8rem;
		color: var(--parchment-dim);
		white-space: nowrap;
	}

	.project p {
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--parchment);
		margin: 0;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin-top: 0.9rem;
	}

	.poster-link,
	.repo-link {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--gold-mid);
		text-decoration: none;
	}

	.poster-link:hover,
	.repo-link:hover {
		color: var(--gold-hi);
	}
</style>
