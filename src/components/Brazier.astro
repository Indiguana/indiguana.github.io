---
interface Props {
	href: string;
	label: string;
	logoSrc: string;
	flameSeed: number;
}

const { href, label, logoSrc, flameSeed } = Astro.props;
---

<a class="brazier" href={href}>
	<div class="brazier-stage">
		<canvas class="brazier-body" data-brazier></canvas>
		<canvas class="flame" data-flame={flameSeed}></canvas>
		<div class="logo-tile"><img src={logoSrc} alt={label} /></div>
	</div>
	<span class="brazier__label">{label}</span>
</a>

<style>
	.brazier {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
	}

	.brazier-stage {
		position: relative;
		width: 138px;
		height: 210px;
	}

	.brazier-stage canvas.brazier-body {
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 122px;
		height: 122px;
		image-rendering: pixelated;
		image-rendering: crisp-edges;
	}

	.brazier-stage canvas.flame {
		position: absolute;
		bottom: 87px;
		left: 50%;
		transform: translateX(-50%);
		width: 130px;
		height: 152px;
		image-rendering: pixelated;
		image-rendering: crisp-edges;
		filter:
			drop-shadow(0 0 6px rgba(255, 170, 70, 0.75))
			drop-shadow(0 0 16px rgba(255, 110, 30, 0.5))
			drop-shadow(0 0 30px rgba(255, 80, 20, 0.3));
	}

	.brazier-stage .logo-tile {
		position: absolute;
		bottom: 92px;
		left: 50%;
		transform: translateX(-50%);
		width: 104px;
		height: 104px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.brazier-stage .logo-tile img {
		max-width: 100%;
		max-height: 100%;
		image-rendering: pixelated;
		image-rendering: crisp-edges;
	}

	.brazier__label {
		font-family: "Manrope", sans-serif;
		font-weight: 800;
		font-size: 0.85rem;
		letter-spacing: 0.03em;
		color: var(--outline);
		background: var(--parchment);
		padding: 0.35rem 1rem;
		border: 2px solid var(--outline);
	}

	.brazier:hover .brazier__label,
	.brazier:focus-visible .brazier__label {
		background: var(--gold-hi);
	}
</style>
