# Free SteamGridDB API key, used to automatically fetch cover art for the
# "currently playing" banner and games list on the Games page. Sign up (free,
# no card) and generate a key at https://www.steamgriddb.com/profile/preferences/api
# Copy this file to .env and fill in the value locally.
STEAMGRIDDB_API_KEY=

# Where the home page reads its Spotify data from. Not a secret — the browser
# fetches it. Default is the JSON snapshot published every 30 minutes by
# .github/workflows/spotify.yml; point it at a deployed worker/ instead if you
# ever want genuinely live now-playing. See worker/README.md.
PUBLIC_SPOTIFY_ENDPOINT=https://raw.githubusercontent.com/Indiguana/indiguana.github.io/spotify-data/spotify.json
